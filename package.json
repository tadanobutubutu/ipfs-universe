{
  "name": "peerstellation",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "peerstellation": "vite",
    "build-wasm": "tsx scripts/build-wasm.ts",
    "build": "npm run build-wasm && vite build",
    "check": "npm run typecheck && npm run test:unit && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "quality": "biome check .",
    "security:semgrep": "semgrep scan --config=auto --error",
    "test:a11y:html": "html-validate --config .htmlvalidate.json index.html public/404.html",
    "test:a11y:pa11y": "start-test 'vite --host 127.0.0.1 --port 4178' http://127.0.0.1:4178 'tsx scripts/run-pa11y.ts'",
    "test:a11y": "npm run test:a11y:html && npm run test:a11y:pa11y",
    "lint:docs": "vale README.md docs",
    "test:lighthouse": "npm run build && start-test 'vite preview --host 127.0.0.1 --port 4181 --strictPort' http://127.0.0.1:4181 'tsx scripts/run-lighthouse.ts'",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:dnslink": "tsx scripts/update-dnslink.ts",
    "deploy:pinata": "tsx scripts/pin-to-pinata.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "npm run build-wasm && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/pa11y": "5.3.7",
    "@types/three": "0.185.4",
    "fake-indexeddb": "6.2.5",
    "html-validate": "11.10.0",
    "lighthouse": "13.4.1",
    "pa11y": "10.0.0",
    "start-server-and-test": "3.0.12",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.0.0",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@helia/libp2p": "2.1.3",
    "@libp2p/bootstrap": "12.0.30",
    "@libp2p/circuit-relay-v2": "4.2.12",
    "@libp2p/identify": "4.1.13",
    "@libp2p/kad-dht": "16.4.4",
    "@libp2p/mplex": "12.0.30",
    "@libp2p/ping": "3.1.12",
    "@libp2p/webrtc": "6.0.30",
    "@libp2p/websockets": "10.1.20",
    "@libp2p/webtransport": "6.0.30",
    "helia": "7.1.10",
    "multiformats": "14.0.5",
    "three": "0.185.1"
  },
  "overrides": {
    "@node-datachannel/android-arm64": "0.33.2"
  }
}
