{
  "name": "ipfs-universe",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "ipfsuniverse": "vite",
    "build-wasm": "zig build-lib wasm/particles.zig -target wasm32-freestanding -O ReleaseSmall -femit-bin=public/particles.wasm -rdynamic",
