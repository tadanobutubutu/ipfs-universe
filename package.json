    "vite": "^8.0.12",
    "vite-plugin-top-level-await": "^1.4.1",
    "vite-plugin-wasm": "^3.3.0"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "three": "^0.168.0",
    "helia": "^5.0.0",
    "@helia/unixfs": "^4.0.0",
    "libp2p": "^2.1.0",
    "@libp2p/websockets": "^10.0.0",
    "@libp2p/webrtc": "^11.0.0",
    "@libp2p/bootstrap": "^12.0.0",
    "@libp2p/mplex": "^11.0.0",
    "@libp2p/yamux": "^11.0.0",
